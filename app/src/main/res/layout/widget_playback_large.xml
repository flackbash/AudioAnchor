<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widgetTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widgetTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_backward_1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_backward_1_image"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/backward_bright" />
            <TextView
                android:id="@+id/widget_backward_1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="10dp"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_backward_2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_backward_2_image"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/backward_bright" />
            <TextView
                android:id="@+id/widget_backward_2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="10dp"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_play_pause"
            android:contentDescription="@string/button_play"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.3"
            android:scaleType="fitCenter"
            android:src="@drawable/play_border_bright" />

        <FrameLayout
            android:id="@+id/widget_forward_1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_forward_1_image"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/forward_bright" />
            <TextView
                android:id="@+id/widget_forward_1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="10dp"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_forward_2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_forward_2_image"
                android:importantForAccessibility="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/forward_bright" />
            <TextView
                android:id="@+id/widget_forward_2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="10dp"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_bookmark"
            android:contentDescription="@string/button_bookmark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_bookmark" />
    </LinearLayout>
</LinearLayout>
