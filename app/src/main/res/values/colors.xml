<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorPrimary">#FF9800</color>
    <color name="colorPrimaryDark">#F57C00</color>
    <color name="colorPrimaryBright">#FFCC80</color>
    <color name="colorAccent">#FF1744</color>

    <color name="colorBackgroundLight">#44B8BCC7</color>
    <color name="colorBackgroundLightNoTrans">#E3E4E9</color>
    <color name="colorBackgroundStrong">#BBDBDDE3</color>
    <color name="colorBackgroundMediumNoTransDarkTheme">#999a9e</color>
    <color name="colorBackgroundLightDarkTheme">#BB6D6E71</color>
    <color name="colorOverlay">#88000000</color>
    <color name="colorBackgroundMediumNoTrans">#5b5c5e</color>

    <color name="colorDeletableIcon">#BB6D6E71</color>
    <color name="colorPlayActivityHeaderBG">#BBDBDDE3</color>

    <!-- A translucent black card, with a colorPrimary ring echoing the one already drawn around
         every play/pause/replay button. -->
    <color name="widgetBackground">#80000000</color>
    <color name="widgetBorder">#99FF9800</color>
    <color name="widgetTextPrimary">#F5F5F5</color>
    <color name="widgetTextSecondary">#B0B0B5</color>

    <!-- Sleep timer quick buttons: fill stays the pale default in light theme (dark text reads
         well on it); dark theme swaps to the more saturated colorPrimaryDark so it doesn't wash
         out, with light text to match. -->
    <color name="sleepTimerQuickButtonFill">@color/colorPrimaryBright</color>
    <color name="sleepTimerQuickButtonFillPressed">@color/colorPrimary</color>
    <color name="sleepTimerQuickButtonText">#212121</color>
</resources>
